# Committed on purpose.
#
# Next.js inlines NEXT_PUBLIC_* into the client bundle at build time, so these
# two values are already visible to anyone who opens the deployed JavaScript.
# Supabase publishes the anon key for exactly this use: it identifies the
# project and nothing more, and every access rule lives in the RLS policies
# under supabase/migrations.
#
# Keeping them here means a fresh clone builds and deploys with no dashboard
# setup, and removes the single most common way this project breaks. Cloudflare
# build variables of the same name still override this file if you prefer that.
#
# Genuine secrets — the model API key, and the runtime Supabase values the Pages
# Functions read — are NOT here. They live in Cloudflare as encrypted secrets.

NEXT_PUBLIC_SUPABASE_URL=https://adkzegihtpehqlvktjbo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_-ZXqfx5mvaJN9uWYGPDVSQ_nJiTXYsj
