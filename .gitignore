# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...except the two NEXT_PUBLIC_* values, which Next inlines into the client
# bundle anyway. Committing them means a deploy needs no dashboard setup.
# See the comment at the top of .env.production.
!.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env.local
.env*.local

# static export output
/out

# wrangler local secrets
.dev.vars
.dev.vars.*
.wrangler/
