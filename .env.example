# --- Supabase (public, safe to ship in the client bundle) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Model provider -------------------------------------------------------
# Set as ENCRYPTED environment variables in the Cloudflare Pages dashboard.
# They are read by the Pages Functions in functions/api/ and never reach the
# browser. Pick one provider; the others can stay empty.
#
#   mistral  — hosted in Paris, GDPR-native, free "Experiment" tier   (default)
#   gemini   — biggest free quota, but free-tier data trains Google's models
#   kimi     — Kimi K2.6, open weights, ~$0.005 per exercise
#   openrouter — any of the above through one key, EU/US routing
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
OPENROUTER_API_KEY=
