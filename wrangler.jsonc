{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albert-maths",
  "compatibility_date": "2026-08-30",

  // Cloudflare Pages project. The Next.js static export lands in ./out and the
  // API lives in functions/ as Pages Functions, which Pages discovers on its own.
  // Do NOT add a _routes.json: Pages detects the functions automatically, and a
  // hand-written one is the usual reason they start 404ing.
  "pages_build_output_dir": "./out"
}
